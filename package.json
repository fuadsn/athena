{
  "name": "athena-company-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "dev:web": "next dev apps/web --webpack -H 127.0.0.1 -p 3100",
    "dev:runtime": "node --env-file-if-exists=.env --import tsx apps/runtime/src/main.ts",
    "dev:lab": "node --env-file-if-exists=.env --import tsx apps/workspace-lab/src/main.ts",
    "build": "tsc --noEmit && next build apps/web --webpack",
    "typecheck": "tsc --noEmit",
    "setup": "node --import tsx scripts/setup.ts",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "demo:reset": "node --env-file-if-exists=.env --import tsx scripts/reset.ts",
    "test": "vitest run --exclude 'tests/integration/**' --exclude 'tests/e2e/**'",
    "test:integration": "GRAPH_INTEGRATION=1 RUNTIME_GRAPH_INTEGRATION=1 vitest run tests/integration packages/graph/test/graph.integration.test.ts",
    "test:e2e": "playwright test",
    "eval:live": "node --env-file-if-exists=.env --import tsx evals/live/run.ts"
  },
  "dependencies": {
    "falkordb": "6.8.0",
    "next": "16.4.2",
    "openai": "7.36.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "falkordblite": "0.3.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
